---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { site, whatsappUrl } from '../data/site';
interface Props { title:string; description:string; schema?:Record<string,unknown>; breadcrumbs?:{label:string;href?:string}[] }
const { title, description, schema, breadcrumbs=[] } = Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><SEO title={title} description={description} schema={schema}/></head><body>
<header style="background:#000;border-bottom:1px solid #171717;position:sticky;top:0;z-index:10"><div class="container" style="display:flex;align-items:center;justify-content:space-between;min-height:76px;gap:1rem"><a href="/" aria-label="Áurea Laser Locação - início"><img src={site.logo} alt="Áurea Laser Locação" style="width:118px;height:auto;display:block"/></a><nav aria-label="Navegação principal" style="display:flex;gap:1.2rem;align-items:center"><a href="/locacao-laser/">Locação</a><a href="/acrus-htm/">Ácrus HTM</a><a href="/laser-day/">Laser Day</a><a href="/cidades/">Cidades</a><a href="/blog/">Blog</a><a class="btn btn-primary" href={whatsappUrl()}>Consultar disponibilidade</a></nav></div></header>
<main>{breadcrumbs.length>0 && <div class="container" style="padding-top:1.25rem;font-size:.85rem;color:var(--muted)" aria-label="Breadcrumb"><a href="/">Início</a>{breadcrumbs.map((item)=><><span> / </span>{item.href?<a href={item.href}>{item.label}</a>:<span>{item.label}</span>}</>)}</div>}<slot /></main>
<footer style="background:var(--ink);color:#eaf1ed;padding:4rem 0 6rem"><div class="container grid cards-3"><div><p style="color:#fff;font-weight:700">Áurea Laser Locação</p><p style="color:#b7c7c4">Locação de equipamentos de laser para clínicas de estética na Baixada Santista.</p></div><div><p style="color:#fff;font-weight:700">Explorar</p><p><a href="/locacao-laser/" style="color:#dbe5e2">Locação de Laser</a><br/><a href="/acrus-htm/" style="color:#dbe5e2">Ácrus HTM</a><br/><a href="/laser-day/" style="color:#dbe5e2">Laser Day</a><br/><a href="/cidades/" style="color:#dbe5e2">Cidades atendidas</a></p></div><div><p style="color:#fff;font-weight:700">Fale com a Áurea</p><p style="color:#b7c7c4">Consulte disponibilidade, datas e condições para a sua clínica.</p><a class="btn btn-primary" href={whatsappUrl()}>Falar no WhatsApp</a></div></div></footer>
<a href={whatsappUrl()} aria-label="Consultar disponibilidade pelo WhatsApp" class="btn btn-primary" style="position:fixed;right:18px;bottom:18px;z-index:20;box-shadow:0 8px 28px #12252d55">WhatsApp</a>
</body></html>
