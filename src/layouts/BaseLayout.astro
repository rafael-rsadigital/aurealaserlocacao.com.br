---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import { site, whatsappUrl } from '../data/site';
interface Props { title:string; description:string; schema?:Record<string,unknown>; breadcrumbs?:{label:string;href?:string}[] }
const { title, description, schema, breadcrumbs=[] } = Astro.props;
---
<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><link rel="icon" type="image/png" href="/images/favicon.png"/><link rel="apple-touch-icon" href="/images/favicon.png"/><SEO title={title} description={description} schema={schema}/></head><body>
<header style="background:#000;border-bottom:1px solid #171717;position:sticky;top:0;z-index:10"><div class="container" style="display:flex;align-items:center;justify-content:space-between;min-height:76px;gap:1rem"><a href="/" aria-label="Áurea Laser Locação - início"><img src={site.logo} alt="Áurea Laser Locação" style="width:118px;height:auto;display:block"/></a><nav aria-label="Navegação principal" style="display:flex;gap:1.2rem;align-items:center"><a href="/locacao-laser/">Locação</a><a href="/acrus-htm/">Ácrus HTM</a><a href="/laser-day/">Laser Day</a><a href="/cidades/">Cidades</a><a href="/empreender-depilacao-laser/">Curso</a><a href="/blog/">Blog</a><a class="btn btn-primary nav-cta" href={whatsappUrl()}>Consultar disponibilidade</a></nav></div></header>
<main>{breadcrumbs.length>0 && <div class="container" style="padding-top:1.25rem;font-size:.85rem;color:var(--muted)" aria-label="Breadcrumb"><a href="/">Início</a>{breadcrumbs.map((item)=><><span> / </span>{item.href?<a href={item.href}>{item.label}</a>:<span>{item.label}</span>}</>)}</div>}<slot /></main>
<footer style="background:var(--ink);color:#eaf1ed;padding:4rem 0 6rem"><div class="container grid cards-3"><div><p style="color:#fff;font-weight:700">Áurea Laser Locação</p><p style="color:#b7c7c4">Locação de equipamentos de laser para clínicas de estética na Baixada Santista.</p></div><div><p style="color:#fff;font-weight:700">Explorar</p><p><a href="/locacao-laser/" style="color:#dbe5e2">Locação de Laser</a><br/><a href="/acrus-htm/" style="color:#dbe5e2">Ácrus HTM</a><br/><a href="/laser-day/" style="color:#dbe5e2">Laser Day</a><br/><a href="/empreender-depilacao-laser/" style="color:#dbe5e2">Curso de depilação a laser</a><br/><a href="/cidades/" style="color:#dbe5e2">Cidades atendidas</a></p></div><div><p style="color:#fff;font-weight:700">Fale com a Áurea</p><p style="color:#b7c7c4">Consulte disponibilidade, datas, vagas e condições para a sua clínica.</p><a class="btn btn-primary" href={whatsappUrl()}>Falar no WhatsApp</a></div></div></footer>
<a href={whatsappUrl()} aria-label="Consultar disponibilidade pelo WhatsApp" class="whatsapp-float"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 3.5A11.8 11.8 0 0 0 12.08 0C5.56 0 .25 5.3.25 11.82c0 2.08.54 4.1 1.57 5.88L.15 24l6.45-1.64a11.8 11.8 0 0 0 5.48 1.35h.01c6.52 0 11.82-5.3 11.82-11.82 0-3.16-1.23-6.13-3.41-8.39ZM12.1 21.7h-.01a9.83 9.83 0 0 1-5.01-1.37l-.36-.21-3.83.98 1.02-3.74-.23-.38a9.83 9.83 0 1 1 8.42 4.72Zm5.4-7.38c-.3-.15-1.77-.87-2.05-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.28-.47-2.44-1.5-.9-.8-1.5-1.78-1.67-2.08-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.87 1.22 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.77-.72 2.02-1.41.25-.69.25-1.28.17-1.41-.07-.12-.27-.2-.57-.35Z"/></svg><span>WhatsApp</span></a>
</body></html>
