---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import FAQ from '../components/FAQ.astro'; import Pricing from '../components/Pricing.astro'; import {whatsappUrl,site} from '../data/site';
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain};
const service={"@type":"Service","@id":`${site.domain}/locacao-laser/#service`,name:'Locação de Laser Ácrus HTM para Clínicas de Estética',serviceType:'Locação de equipamento para depilação a laser',provider:{"@id":`${site.domain}/#organization`},areaServed:site.cities.map(city=>({"@type":"City",name:city.name})),url:site.domain+'/locacao-laser/'};
const schema={"@context":"https://schema.org","@graph":[organization,service]} as Record<string, unknown>;
const steps=[['01','Consulte a disponibilidade','Informe sua cidade, o período escolhido e o tipo de atendimento.'],['02','Escolha a data','A data é definida conforme a agenda da clínica e a disponibilidade do equipamento.'],['03','Prepare sua agenda','Organize os atendimentos e comunique seus clientes.'],['04','Receba e monte','A Áurea Laser realiza a entrega e a montagem técnica conforme combinado.'],['05','Realize os atendimentos','Use o período contratado para realizar os atendimentos.']];
const faq=[{q:'Quanto custa a locação?',a:'A promoção atual oferece períodos de 6, 8 ou 12 horas. Consulte os valores exibidos nesta página e confirme a disponibilidade da data pelo WhatsApp.'},{q:'Preciso ter uma profissional habilitada?',a:'Sim. A locação tem como foco o equipamento, e a clínica deve contar com profissional habilitada para realizar os procedimentos.'},{q:'Como faço para reservar?',a:'Envie pelo WhatsApp a cidade, o período escolhido e a data desejada. A Áurea Laser verifica a disponibilidade e combina as condições da locação.'},{q:'Quais cidades são atendidas?',a:`A Áurea Laser atende Guarujá, Santos, Praia Grande, São Vicente, Cubatão e Bertioga, conforme disponibilidade e logística.`},{q:'O que está incluído?',a:'Conforme as condições combinadas, a locação envolve o equipamento e pode incluir entrega, montagem, preparação técnica e manutenção sob responsabilidade da locadora.'}];
---
<BaseLayout title="Locação de Ácrus HTM para Clínicas de Estética | Áurea Laser" description="Entenda como funciona a locação do Ácrus HTM para clínicas de estética: consulta, agenda, entrega, montagem e operação na Baixada Santista." schema={schema} breadcrumbs={[{label:'Locação de Laser'}]}>
<section class="section"><div class="container" style="max-width:850px"><span class="eyebrow">Locação de Ácrus HTM · Baixada Santista</span><h1>Locação de Ácrus HTM para Clínicas de Estética</h1><p style="font-size:1.25rem">Alugue o Ácrus HTM para a data que sua clínica precisa, realize um Laser Day ou abra uma agenda específica de depilação a laser sem comprar o equipamento.</p><a class="btn btn-primary" href={whatsappUrl()}>Consultar disponibilidade</a></div></section>
<Pricing />
<section class="section" style="background:#111614"><div class="container"><span class="eyebrow">Como funciona</span><h2>Como funciona a locação do Ácrus HTM</h2><div class="grid cards-3" style="margin-top:2rem">{steps.map(([n,t,d])=><div class="card"><span class="numbers">{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section>
<section class="section"><div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem"><div><span class="eyebrow">O que está incluído</span><h2>O que está incluído na locação</h2></div><div class="prose"><p>Conforme as condições combinadas, a locação envolve o equipamento e pode incluir entrega, montagem, preparação técnica e manutenção sob responsabilidade da locadora.</p><p>A clínica deve contar com profissional habilitada para realizar os procedimentos. Preços e termos dependem da disponibilidade e da negociação de cada locação.</p></div></div></section>
<section class="section" style="background:#0f1110"><div class="container" style="max-width:850px"><span class="eyebrow">Dúvidas sobre a locação</span><h2>Antes de reservar</h2><FAQ items={faq}/></div></section><CTA label="Quero reservar uma data"/>
</BaseLayout>
