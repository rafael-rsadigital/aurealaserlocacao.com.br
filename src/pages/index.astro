---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import FAQ from '../components/FAQ.astro'; import {site,whatsappUrl} from '../data/site';
const faq=[{q:'Preciso comprar o equipamento?',a:'Não. A proposta da Áurea Laser é oferecer a locação do Ácrus HTM para operações planejadas da clínica, como um Laser Day.'},{q:'Como funciona a entrega?',a:'A Áurea Laser comunica entrega, montagem e preparação técnica conforme a disponibilidade e as condições combinadas.'},{q:'Vocês fornecem a aplicadora?',a:'A máquina pode ser fornecida com ou sem aplicadora, conforme a configuração e o planejamento da operação.'},{q:'Como consulto disponibilidade?',a:'Fale pelo WhatsApp informando sua cidade, período desejado e o tipo de operação.'}];
const schema={"@context":"https://schema.org","@type":"Organization",name:site.name,url:site.domain,description:site.description};
---
<BaseLayout title="Locação de Laser Ácrus HTM para Clínicas | Áurea Laser" description="Alugue o Ácrus HTM Triple Wave para sua clínica de estética na Baixada Santista. Organize seu Laser Day com entrega e montagem técnica." schema={schema}>
<section class="hero" style="background:radial-gradient(circle at 80% 20%,#211a0d 0%,#070707 42%,#000 100%)"><div class="container hero-grid"><div><span class="eyebrow">Locação profissional · Baixada Santista</span><h1>Laser profissional para a agenda da sua clínica.</h1><p style="font-size:1.1rem;max-width:570px">Leve o Ácrus HTM Triple Wave para realizar atendimentos e Laser Days sem precisar comprar o equipamento.</p><div style="display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.4rem"><a class="btn btn-primary" href={whatsappUrl()}>Consultar disponibilidade</a><a class="btn btn-ghost" href="/acrus-htm/">Conhecer o Ácrus HTM</a></div></div><div class="hero-image"><img src={site.equipmentImage} alt="Equipamento Ácrus HTM Triple Wave para locação" width="627" height="482"/></div></div></section>
<section style="background:var(--ink);color:#fff;padding:1.4rem 0"><div class="container grid cards-4"><div><b>Laser Day</b><small style="display:block;color:#b7c7c4">Agenda concentrada</small></div><div><b>Logística própria</b><small style="display:block;color:#b7c7c4">Entrega regional</small></div><div><b>Entrega técnica</b><small style="display:block;color:#b7c7c4">Montagem e preparo</small></div><div><b>Equipamento revisado</b><small style="display:block;color:#b7c7c4">Pronto para uso</small></div></div></section>
<section class="section" style="background:#050505"><div class="container"><span class="eyebrow">Oferta especial</span><h2>{site.promotion.title}</h2><p style="max-width:680px">Escolha a duração que melhor se encaixa na agenda da sua clínica. Consulte a disponibilidade da data pelo WhatsApp.</p><div class="grid cards-3" style="margin-top:2rem">{site.promotion.plans.map((plan, index)=><div class:list={['price-card', index===1 && 'featured']}><span class="price-duration">{plan.duration}</span><span class="price-old">De {plan.from}</span><strong class="price-now">{plan.price}</strong><a class="btn btn-primary" href={whatsappUrl(`Olá! Gostaria de consultar a disponibilidade da promoção de ${plan.duration} para minha clínica.`)}>Consultar esta opção</a></div>)}</div><p style="font-size:.9rem;margin-top:1.25rem">{site.promotion.shipping}</p></div></section>
<section class="section"><div class="container"><div class="prose"><span class="eyebrow">Uma decisão mais flexível</span><h2>Comece pela operação que faz sentido para sua clínica.</h2><p>Alugar pode ser uma forma de testar a demanda, organizar um Laser Day e acessar tecnologia profissional sem imobilizar capital na compra de uma máquina. As condições dependem do período, da cidade e do que for combinado com a Áurea Laser.</p></div><div class="grid cards-3" style="margin-top:2.5rem"><div class="card"><span class="numbers">01</span><h3>Planeje a agenda</h3><p>Concentre os atendimentos e comunique sua data com antecedência.</p></div><div class="card"><span class="numbers">02</span><h3>Reserve o equipamento</h3><p>Consulte disponibilidade do Ácrus HTM para sua clínica.</p></div><div class="card"><span class="numbers">03</span><h3>Realize o Laser Day</h3><p>Receba, monte e prepare o equipamento conforme o combinado.</p></div></div></div></section>
<section class="section" style="background:#111614"><div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center"><div><span class="eyebrow">Triple Wave</span><h2>Uma plataforma, três comprimentos de onda.</h2><p>O Ácrus HTM combina Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm. O resfriamento da ponteira e os parâmetros adequados fazem parte da preparação técnica do atendimento.</p><a class="btn btn-ghost" href="/acrus-htm/">Ver detalhes do equipamento</a></div><div class="grid cards-3"><div class="card"><b>755 nm</b><p>Alexandrite</p></div><div class="card"><b>808 nm</b><p>Diodo</p></div><div class="card"><b>1064 nm</b><p>Nd:YAG</p></div></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Onde atendemos</span><h2>Locação de laser na Baixada Santista.</h2><div class="grid cards-3" style="margin-top:2rem">{site.cities.map(city=><a class="card" href={`/cidades/${city.slug}/`}><h3>{city.name}</h3><p>Consultar locação de laser em {city.name} →</p></a>)}</div></div></section>
<section class="section" style="background:#0f1110"><div class="container" style="max-width:850px"><span class="eyebrow">Dúvidas frequentes</span><h2>Antes de reservar, entenda o processo.</h2><FAQ items={faq}/></div></section><CTA label="Falar com a Áurea Laser"/>
</BaseLayout>
