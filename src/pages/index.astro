---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import FAQ from '../components/FAQ.astro'; import Pricing from '../components/Pricing.astro'; import {site,whatsappUrl} from '../data/site';
const faq=[
  {q:'Preciso comprar o equipamento?',a:'Não. A proposta da Áurea Laser é oferecer a locação do Ácrus HTM para um Laser Day ou uma data específica de atendimento.'},
  {q:'A locação inclui uma profissional para realizar os atendimentos?',a:'Não. O foco da locação é o equipamento Ácrus HTM Triple Wave para clínicas que já possuem profissional habilitada para realizar os procedimentos. Consulte a Áurea Laser sobre as condições específicas da locação.'},
  {q:'Como funciona a entrega?',a:'A Áurea Laser combina entrega, montagem e preparação técnica conforme a disponibilidade, a cidade e as condições da locação.'},
  {q:'Como consulto disponibilidade?',a:'Fale pelo WhatsApp informando sua cidade, período escolhido e o tipo de atendimento.'}
];
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,description:site.description,logo:new URL(site.logo,site.domain).toString(),telephone:`+${site.whatsapp}`,sameAs:site.socialLinks.map((social:any)=>social.url)};
const service={"@type":"Service","@id":`${site.domain}/#locacao-acrus`,name:'Locação de Ácrus HTM para depilação a laser',serviceType:'Locação de equipamento para depilação a laser',description:'Locação do equipamento Ácrus HTM Triple Wave para clínicas de estética na Baixada Santista.',provider:{"@id":`${site.domain}/#organization`},areaServed:site.cities.map(city=>({"@type":"City",name:city.name})),url:site.domain+'/' };
const schema={"@context":"https://schema.org","@graph":[organization,service,{"@type":"WebSite","@id":`${site.domain}/#website`,name:site.name,url:site.domain}]} as Record<string, unknown>;
---
<BaseLayout title="Locação de Ácrus HTM para Depilação a Laser | Áurea Laser" description="Locação do Ácrus HTM Triple Wave para depilação a laser em clínicas de estética na Baixada Santista. Consulte disponibilidade e condições." schema={schema}>
<section class="hero" style="background:radial-gradient(circle at 80% 20%,#211a0d 0%,#070707 42%,#000 100%)"><div class="container hero-grid"><div><span class="eyebrow">Locação profissional · Baixada Santista</span><h1>Locação de Ácrus HTM para Depilação a Laser</h1><p style="font-size:1.1rem;max-width:570px">Aluguel do equipamento Ácrus HTM Triple Wave para clínicas de estética que desejam realizar atendimentos e Laser Days sem precisar comprar o equipamento.</p><div style="display:flex;gap:.7rem;flex-wrap:wrap;margin-top:1.4rem"><a class="btn btn-primary" href={whatsappUrl()}>Consultar disponibilidade</a><a class="btn btn-ghost" href="/acrus-htm/">Conhecer o Ácrus HTM</a></div></div><div class="hero-image"><img src={site.equipmentImage} alt="Equipamento Ácrus HTM Triple Wave para locação" width="627" height="482"/></div></div></section>
<section style="background:var(--ink);color:#fff;padding:1.4rem 0"><div class="container grid cards-4"><div><b>Laser Day</b><small style="display:block;color:#b7c7c4">Agenda concentrada</small></div><div><b>Logística regional</b><small style="display:block;color:#b7c7c4">Atendimento na região</small></div><div><b>Entrega técnica</b><small style="display:block;color:#b7c7c4">Montagem e preparo</small></div><div><b>Equipamento revisado</b><small style="display:block;color:#b7c7c4">Pronto para uso</small></div></div></section>
<Pricing />
<section class="section"><div class="container"><div class="prose"><span class="eyebrow">Locação por período</span><h2>Alugue o equipamento para a data que sua clínica precisa</h2><p>Você não precisa comprar um equipamento para realizar um Laser Day ou abrir uma agenda específica de depilação a laser. Consulte a disponibilidade do Ácrus HTM para o período em que deseja atender.</p></div><div class="grid cards-3" style="margin-top:2.5rem"><div class="card"><span class="numbers">01</span><h3>Escolha o período</h3><p>Consulte uma locação de 6, 8 ou 12 horas para a agenda da sua clínica.</p></div><div class="card"><span class="numbers">02</span><h3>Reserve a data</h3><p>Informe sua cidade, a data desejada e o tipo de atendimento pelo WhatsApp.</p></div><div class="card"><span class="numbers">03</span><h3>Atenda seus clientes</h3><p>Use o equipamento durante o período contratado para realizar os procedimentos.</p></div></div></div></section>
<section class="section" style="background:#111614"><div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center"><div><span class="eyebrow">Triple Wave</span><h2>Uma plataforma, três comprimentos de onda.</h2><p>O Ácrus HTM combina Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm. O resfriamento da ponteira e os parâmetros adequados fazem parte da preparação técnica do atendimento.</p><a class="btn btn-ghost" href="/acrus-htm/">Ver detalhes do equipamento</a></div><div class="grid cards-3"><div class="card"><b>755 nm</b><p>Alexandrite</p></div><div class="card"><b>808 nm</b><p>Diodo</p></div><div class="card"><b>1064 nm</b><p>Nd:YAG</p></div></div></div></section>
<section class="section"><div class="container"><span class="eyebrow">Onde atendemos</span><h2>Locação de laser na Baixada Santista.</h2><div class="grid cards-3" style="margin-top:2rem">{site.cities.map(city=><a class="card" href={`/cidades/${city.slug}/`}><h3>{city.name}</h3><p>Consultar locação de Ácrus HTM em {city.name} →</p></a>)}</div></div></section>
<section class="section" style="background:#0f1110"><div class="container" style="max-width:850px"><span class="eyebrow">Dúvidas frequentes</span><h2>Antes de reservar, entenda o processo.</h2><FAQ items={faq}/></div></section><CTA label="Falar com a Áurea Laser"/>
</BaseLayout>
