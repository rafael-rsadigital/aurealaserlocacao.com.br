---
import BaseLayout from '../../layouts/BaseLayout.astro'; import CTA from '../../components/CTA.astro'; import FAQ from '../../components/FAQ.astro'; import Pricing from '../../components/Pricing.astro'; import {site,whatsappUrl} from '../../data/site';
export function getStaticPaths(){return site.cities.map(city=>({params:{slug:city.slug},props:{city}}));}
const {city}=Astro.props; const others=site.cities.filter((c:any)=>c.slug!==city.slug).slice(0,3); const message=`Olá! Tenho uma clínica em ${city.name} e gostaria de consultar a disponibilidade para locação do Ácrus HTM.`; const faq=[{q:`Como funciona a locação de laser em ${city.name}?`,a:`Você informa o período e a operação desejada. A Áurea Laser verifica a disponibilidade e combina entrega, montagem e preparação técnica conforme o caso.`},{q:'Posso organizar um Laser Day?',a:'Sim. O modelo Laser Day concentra a agenda da clínica em uma data planejada para os atendimentos.'},{q:`A Áurea Laser atende ${city.name} sempre?`,a:'O atendimento depende de disponibilidade de agenda e logística. Consulte a Áurea Laser pelo WhatsApp.'}];
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain};
const service={"@type":"Service","@id":`${site.domain}/cidades/${city.slug}/#service`,name:`Locação de Ácrus HTM em ${city.name}`,serviceType:'Locação de equipamento para depilação a laser',provider:{"@id":`${site.domain}/#organization`},areaServed:{"@type":"City",name:city.name},url:`${site.domain}/cidades/${city.slug}/`};
const schema={"@context":"https://schema.org","@graph":[organization,service]} as Record<string, unknown>;
---
<BaseLayout title={`Locação de Ácrus HTM para Depilação a Laser em ${city.name} | Áurea Laser`} description={`Locação do Ácrus HTM para depilação a laser em clínicas de estética em ${city.name}. Consulte disponibilidade para seu Laser Day.`} schema={schema} breadcrumbs={[{label:'Cidades',href:'/cidades/'},{label:city.name}]}>
<section class="section"><div class="container city-intro"><div><span class="eyebrow">Baixada Santista · {city.name}</span><h1>Locação de Ácrus HTM em {city.name}</h1><p style="font-size:1.2rem">Se sua clínica está em {city.name} e busca {city.context}, a Áurea Laser oferece locação do Ácrus HTM para operações planejadas de depilação a laser.</p><a class="btn btn-primary" href={whatsappUrl(message)}>Consultar disponibilidade em {city.name}</a></div><div class="city-image"><img src={site.equipmentImage} alt={`Equipamento Ácrus HTM Triple Wave para depilação a laser em ${city.name}`} width="627" height="482"/></div></div></section>
<Pricing city={city.name} />
<section class="section" style="background:#111614"><div class="container grid cards-3"><div class="card"><h3>Equipamento profissional</h3><p>Conheça o Ácrus HTM Triple Wave e seus três comprimentos de onda.</p><a href="/acrus-htm/">Ver equipamento →</a></div><div class="card"><h3>Logística combinada</h3><p>Entrega, montagem e preparação técnica conforme disponibilidade.</p><a href="/locacao-laser/">Como funciona →</a></div><div class="card"><h3>Laser Day</h3><p>Concentre sua agenda em uma operação planejada para a clínica.</p><a href="/laser-day/">Conhecer Laser Day →</a></div></div></section>
<section class="section"><div class="container prose"><span class="eyebrow">Atendimento local</span><h2>Locação de Ácrus HTM para clínicas em {city.name}</h2><p>A operação é planejada de acordo com a agenda da clínica, o período desejado e a logística disponível para {city.name}. A locação tem como foco o equipamento, e os atendimentos devem ser realizados por profissional habilitada.</p></div></section>
<section class="section"><div class="container" style="max-width:850px"><span class="eyebrow">Dúvidas locais</span><h2>Locação em {city.name}: perguntas frequentes</h2><FAQ items={faq}/><h3 style="margin-top:3rem">Também atendemos</h3><p>{others.map((other:any)=><a href={`/cidades/${other.slug}/`} style="margin-right:1rem">{other.name}</a>)}</p></div></section>
<CTA label={`Consultar disponibilidade em ${city.name}`} message={message}/>
</BaseLayout>
