---
import BaseLayout from '../../layouts/BaseLayout.astro'; import CTA from '../../components/CTA.astro'; import {site} from '../../data/site';
---
<BaseLayout title="Cidades atendidas | Locação de Laser na Baixada Santista" description="Consulte locação do Ácrus HTM para clínicas de estética em Guarujá, Santos, Praia Grande, São Vicente, Cubatão e Bertioga." breadcrumbs={[{label:'Cidades'}]}>
<section class="section"><div class="container" style="max-width:850px"><span class="eyebrow">Atendimento regional</span><h1>Locação de laser na Baixada Santista</h1><p style="font-size:1.2rem">A Áurea Laser atende clínicas de estética em cidades da Baixada Santista com locação do Ácrus HTM, entrega e montagem conforme disponibilidade.</p></div></section><section class="section" style="background:#111614"><div class="container"><div class="grid cards-3">{site.cities.map(city=><a class="card" href={`/cidades/${city.slug}/`}><h2 style="font-size:1.6rem">{city.name}</h2><p>Locação de laser para clínica em {city.name}.</p></a>)}</div></div></section><CTA label="Ver disponibilidade para minha cidade"/>
</BaseLayout>
