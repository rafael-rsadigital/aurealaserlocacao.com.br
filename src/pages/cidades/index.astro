---
import BaseLayout from '../../layouts/BaseLayout.astro'; import CTA from '../../components/CTA.astro'; import {site} from '../../data/site';
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:'Cidades atendidas pela Áurea Laser',url:site.domain+'/cidades/',description:'Locação do Ácrus HTM para clínicas de estética em cidades da Baixada Santista.',about:{"@type":"Service",name:'Locação de Ácrus HTM para depilação a laser',areaServed:site.cities.map(city=>({"@type":"City",name:city.name}))}} as Record<string, unknown>;
---
<BaseLayout title="Cidades atendidas | Locação de Ácrus HTM na Baixada Santista" description="Consulte locação do Ácrus HTM para clínicas de estética em Guarujá, Santos, Praia Grande, São Vicente, Cubatão e Bertioga." schema={schema} breadcrumbs={[{label:'Cidades'}]}>
<section class="section"><div class="container" style="max-width:850px"><span class="eyebrow">Atendimento regional</span><h1>Locação de Ácrus HTM na Baixada Santista</h1><p style="font-size:1.2rem">A Áurea Laser atende clínicas de estética em cidades da Baixada Santista com locação do Ácrus HTM, entrega e montagem conforme disponibilidade.</p></div></section><section class="section" style="background:#111614"><div class="container"><div class="grid cards-3">{site.cities.map(city=><a class="card" href={`/cidades/${city.slug}/`}><h2 style="font-size:1.6rem">{city.name}</h2><p>Locação de Ácrus HTM para depilação a laser em {city.name}.</p></a>)}</div></div></section><CTA label="Ver disponibilidade para minha cidade"/>
</BaseLayout>
