---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';
import FAQ from '../components/FAQ.astro';
import { site, whatsappUrl } from '../data/site';
const courseMessage = 'Olá! Gostaria de consultar a disponibilidade de vagas para o curso teórico e prático de depilação a laser.';
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain};
const course={"@type":"Course","@id":`${site.domain}/empreender-depilacao-laser/#course`,name:'Curso teórico e prático de depilação a laser',description:'Curso da Áurea Laser sobre fundamentos da depilação a laser, rotina de atendimento, administração e marketing para Laser Day.',provider:{"@id":`${site.domain}/#organization`},url:`${site.domain}/empreender-depilacao-laser/`};
const schema={"@context":"https://schema.org","@graph":[organization,course]} as Record<string, unknown>;
const faq=[
  {q:'Quem pode consultar o curso?',a:'Entre em contato com a Áurea Laser para receber informações sobre o público, os pré-requisitos e as próximas turmas.'},
  {q:'O curso é teórico e prático?',a:'Sim. A proposta inclui conteúdo teórico e prática sobre depilação a laser. Consulte a disponibilidade de vagas e os detalhes da próxima turma.'},
  {q:'O curso ensina a organizar um Laser Day?',a:'O conteúdo aborda a organização da agenda, o uso do equipamento em uma data de atendimento e pontos da rotina de um Laser Day.'},
  {q:'O curso fala sobre administração e marketing?',a:'Sim. A formação aborda pontos de administração da atividade e ações de marketing para divulgar e organizar um Laser Day.'},
  {q:'Como consulto as vagas?',a:'Envie uma mensagem pelo WhatsApp informando seu interesse no curso teórico e prático. A Áurea Laser informa a disponibilidade de vagas e as condições da próxima turma.'}
];
---
<BaseLayout title="Curso de Depilação a Laser: Teórico e Prático | Áurea Laser" description="Aprenda sobre depilação a laser em um curso teórico e prático da Áurea Laser, com conteúdo sobre administração, marketing e Laser Day. Consulte vagas." schema={schema} breadcrumbs={[{label:'Empreender na Depilação a Laser'}]}>
<section class="section" style="background:radial-gradient(circle at 80% 20%,#211a0d 0%,#070707 42%,#000 100%)"><div class="container" style="max-width:900px"><span class="eyebrow">Formação · Áurea Laser</span><h1>Empreender na área da depilação a laser</h1><p style="font-size:1.25rem;max-width:760px">Conheça o mercado de depilação a laser e prepare-se para estruturar seus atendimentos com um curso teórico e prático oferecido pela Áurea Laser.</p><a class="btn btn-primary" href={whatsappUrl(courseMessage)}>Consultar disponibilidade de vagas</a></div></section>
<section class="section"><div class="container prose"><span class="eyebrow">Mercado de depilação a laser</span><h2>Uma atividade que exige conhecimento técnico e organização</h2><p>A depilação a laser faz parte dos serviços oferecidos por clínicas e profissionais da área de estética. Para empreender nesse segmento, não basta conhecer o equipamento: é importante entender a rotina de atendimento, organizar a agenda, comunicar o serviço e acompanhar os custos da atividade.</p><p>A Áurea Laser apresenta uma formação voltada para quem quer conhecer melhor esse mercado e entender como uma data de atendimentos pode ser estruturada com o modelo de Laser Day.</p></div></section>
<section class="section" style="background:#111614"><div class="container"><span class="eyebrow">Curso teórico e prático</span><h2>O que você vai estudar</h2><div class="grid cards-3" style="margin-top:2rem"><div class="card"><span class="numbers">01</span><h3>Depilação a laser</h3><p>Fundamentos da tecnologia, rotina do atendimento e pontos que devem ser observados na preparação dos procedimentos.</p></div><div class="card"><span class="numbers">02</span><h3>Administração</h3><p>Organização da agenda, definição do período de atendimento, relacionamento com clientes e rotina de um Laser Day.</p></div><div class="card"><span class="numbers">03</span><h3>Marketing</h3><p>Como comunicar a data, divulgar o serviço, organizar os contatos e transformar o Laser Day em uma ação comercial para a clínica.</p></div></div></div></section>
<section class="section"><div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;align-items:start"><div class="prose"><span class="eyebrow">Na prática</span><h2>Do conhecimento à organização do Laser Day</h2><p>O curso combina conteúdo teórico e prática para aproximar o aprendizado da rotina de uma clínica. A proposta é mostrar como preparar a data, organizar os horários, receber o equipamento e conduzir a comunicação com os clientes.</p></div><div class="card"><h3>Quer saber quando será a próxima turma?</h3><p>Entre em contato para consultar vagas, datas, formato do curso e condições de participação.</p><a class="btn btn-primary" href={whatsappUrl(courseMessage)}>Consultar vagas pelo WhatsApp</a></div></div></section>
<section class="section" style="background:#0f1110"><div class="container" style="max-width:850px"><span class="eyebrow">Perguntas frequentes</span><h2>Sobre o curso de depilação a laser</h2><FAQ items={faq}/></div></section><CTA label="Consultar disponibilidade de vagas" message={courseMessage}/>
</BaseLayout>
