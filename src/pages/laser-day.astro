---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import FAQ from '../components/FAQ.astro'; import Pricing from '../components/Pricing.astro'; import {whatsappUrl,site} from '../data/site';
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain,sameAs:site.socialLinks.map((social:any)=>social.url)};
const service={"@type":"Service","@id":`${site.domain}/laser-day/#service`,name:'Laser Day com locação de Ácrus HTM',serviceType:'Laser Day com equipamento para depilação a laser',provider:{"@id":`${site.domain}/#organization`},areaServed:site.cities.map(city=>({"@type":"City",name:city.name})),url:site.domain+'/laser-day/'};
const schema={"@context":"https://schema.org","@graph":[organization,service]} as Record<string, unknown>;
const steps=[['01','A clínica agenda','Você concentra os clientes e estrutura o dia de atendimentos.'],['02','A Áurea entrega','O equipamento é levado ao local na data e conforme a logística combinada.'],['03','Montagem e preparo','A máquina é montada e preparada tecnicamente para os atendimentos.'],['04','Os atendimentos acontecem','A clínica realiza os atendimentos com sua equipe ou profissional habilitada.'],['05','Retirada conforme combinado','Ao final do período contratado, o equipamento é retirado conforme combinado.']];
const faq=[{q:'O que é um Laser Day?',a:'É uma data de atendimentos de depilação a laser organizada pela clínica com a locação do Ácrus HTM por um período contratado.'},{q:'Quanto tempo dura a locação?',a:'A promoção atual oferece períodos de 6, 8 ou 12 horas. Consulte a disponibilidade da data e o período que melhor atende sua agenda.'},{q:'A clínica precisa ter profissional habilitada?',a:'Sim. A locação tem como foco o equipamento, e os procedimentos devem ser realizados por profissional habilitada.'},{q:'Como funciona a entrega e a montagem?',a:'A Áurea Laser leva o equipamento ao local, realiza a montagem e faz a preparação técnica conforme a data, a cidade e as condições combinadas.'},{q:'Como reservar um Laser Day?',a:'Envie pelo WhatsApp sua cidade, a data desejada e o período escolhido. A Áurea Laser verifica a disponibilidade.'}];
---
<BaseLayout title="Laser Day com Ácrus HTM | Locação de Laser | Áurea Laser" description="Organize um Laser Day na sua clínica com locação do Ácrus HTM, entrega, montagem e preparação técnica na Baixada Santista." schema={schema} breadcrumbs={[{label:'Laser Day'}]}>
<section class="section" style="background:var(--ink);color:#fff"><div class="container" style="max-width:900px"><span class="eyebrow">Laser Day na clínica</span><h1>Laser Day com Locação de Ácrus HTM</h1><p style="color:#d5e1de;font-size:1.25rem">Organize a agenda, reserve o equipamento e concentre os atendimentos de depilação a laser na data escolhida para sua clínica.</p><a class="btn btn-primary" href={whatsappUrl('Olá! Quero organizar um Laser Day e consultar a disponibilidade do Ácrus HTM.')}>Quero organizar meu Laser Day</a></div></section>
<Pricing />
<section class="section"><div class="container prose"><span class="eyebrow">Como funciona</span><h2>O que é um Laser Day?</h2><p>É uma data em que a clínica concentra os atendimentos de depilação a laser. A equipe organiza os horários, reserva o Ácrus HTM por 6, 8 ou 12 horas e recebe o equipamento conforme as condições combinadas.</p><h2>Como o Ácrus HTM entra na agenda?</h2><p>O equipamento é levado à clínica, montado e preparado para os atendimentos. Durante o período contratado, a equipe realiza os procedimentos conforme seus protocolos e, ao final, a retirada ocorre conforme combinado.</p><h2>A clínica precisa ter profissional?</h2><p>Sim. A locação é do equipamento. A clínica deve contar com profissional habilitada para realizar os procedimentos.</p></div></section>
<section class="section" style="background:#111614"><div class="container"><span class="eyebrow">Em cinco etapas</span><h2>Como funciona o Laser Day na clínica</h2><div class="grid cards-3" style="margin-top:2rem">{steps.map(([n,t,d])=><div class="card"><span class="numbers">{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section>
<section class="section"><div class="container" style="max-width:850px"><span class="eyebrow">Dúvidas frequentes</span><h2>Antes de reservar sua data</h2><FAQ items={faq}/></div></section><CTA label="Quero fazer um Laser Day"/>
</BaseLayout>
