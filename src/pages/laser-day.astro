---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import {whatsappUrl,site} from '../data/site';
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain};
const service={"@type":"Service","@id":`${site.domain}/laser-day/#service`,name:'Laser Day com locação de Ácrus HTM',serviceType:'Laser Day com equipamento para depilação a laser',provider:{"@id":`${site.domain}/#organization`},areaServed:site.cities.map(city=>({"@type":"City",name:city.name})),url:site.domain+'/laser-day/'};
const schema={"@context":"https://schema.org","@graph":[organization,service]} as Record<string, unknown>;
const steps=[['01','A clínica agenda','Você concentra os clientes e estrutura o dia de atendimentos.'],['02','A Áurea entrega','O equipamento é levado ao local na data e conforme a logística combinada.'],['03','Montagem e preparo','A máquina é montada e preparada tecnicamente para os atendimentos.'],['04','Os atendimentos acontecem','A clínica realiza os atendimentos com sua equipe ou profissional habilitada.'],['05','Retirada conforme combinado','Ao final do período contratado, o equipamento é retirado conforme combinado.']];
---
<BaseLayout title="Laser Day com Ácrus HTM | Locação de Laser | Áurea Laser" description="Organize um Laser Day na sua clínica com locação do Ácrus HTM, entrega, montagem e preparação técnica na Baixada Santista." schema={schema} breadcrumbs={[{label:'Laser Day'}]}>
<section class="section" style="background:var(--ink);color:#fff"><div class="container" style="max-width:900px"><span class="eyebrow">Laser Day na clínica</span><h1>Laser Day com Locação de Ácrus HTM</h1><p style="color:#d5e1de;font-size:1.25rem">Organize a agenda, reserve o equipamento e concentre os atendimentos de depilação a laser na data escolhida para sua clínica.</p><a class="btn btn-primary" href={whatsappUrl('Olá! Quero organizar um Laser Day e consultar a disponibilidade do Ácrus HTM.')}>Quero organizar meu Laser Day</a></div></section>
<section class="section"><div class="container"><span class="eyebrow">Em cinco etapas</span><h2>Um processo simples de entender.</h2><div class="grid cards-3" style="margin-top:2rem">{steps.map(([n,t,d])=><div class="card"><span class="numbers">{n}</span><h3>{t}</h3><p>{d}</p></div>)}</div></div></section><CTA label="Quero fazer um Laser Day"/>
</BaseLayout>
