---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import FAQ from '../components/FAQ.astro'; import {site,whatsappUrl} from '../data/site';
const faq=[{q:'O que é a tecnologia Triple Wave?',a:'É a combinação dos comprimentos de onda Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm em uma mesma plataforma.'},{q:'O equipamento possui resfriamento?',a:'Sim. O Ácrus HTM comunica sistema de resfriamento da ponteira, que deve ser utilizado conforme os parâmetros e a preparação técnica adequados.'},{q:'Posso usar o equipamento em um Laser Day?',a:'Sim. A locação é adequada para clínicas que desejam organizar uma operação de Laser Day, sempre mediante consulta de disponibilidade.'},{q:'A locação inclui uma profissional?',a:'Não. O foco da locação é o equipamento. A clínica deve contar com profissional habilitada para realizar os procedimentos.'}];
const organization={"@type":"Organization","@id":`${site.domain}/#organization`,name:site.name,url:site.domain};
const service={"@type":"Service","@id":`${site.domain}/acrus-htm/#service`,name:'Locação de Ácrus HTM Triple Wave para Depilação a Laser',serviceType:'Locação de equipamento para depilação a laser',provider:{"@id":`${site.domain}/#organization`},areaServed:site.cities.map(city=>({"@type":"City",name:city.name})),url:site.domain+'/acrus-htm/'};
const schema={"@context":"https://schema.org","@graph":[organization,service,{"@type":"Product",name:'Ácrus HTM Triple Wave',brand:{"@type":"Brand",name:'HTM'},description:'Equipamento profissional de laser com três comprimentos de onda, disponível para locação por clínicas de estética.',image:new URL(site.equipmentImage,site.domain).toString()}]} as Record<string, unknown>;
---
<BaseLayout title="Ácrus HTM para Depilação a Laser | Locação | Áurea Laser" description="Conheça o Ácrus HTM Triple Wave para depilação a laser: Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm. Locação para clínicas na Baixada Santista." schema={schema} breadcrumbs={[{label:'Ácrus HTM'}]}>
<section class="section"><div class="container equipment-intro"><div><span class="eyebrow">Equipamento profissional para locação</span><h1>Ácrus HTM Triple Wave para Depilação a Laser</h1><p style="font-size:1.25rem">O Ácrus HTM Triple Wave reúne três comprimentos de onda — Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm — em um único equipamento disponível para locação pela Áurea Laser.</p><a class="btn btn-primary" href={whatsappUrl('Olá! Gostaria de consultar a disponibilidade do Ácrus HTM para a minha clínica.')}>Consultar disponibilidade</a></div><div class="card"><img src={site.equipmentImage} alt="Equipamento Ácrus HTM Triple Wave para depilação a laser" width="627" height="482"/></div></div></section>
<section class="section" style="background:var(--ink);color:#fff"><div class="container"><span class="eyebrow">Tecnologia Triple Wave</span><h2 style="color:#fff">Os três comprimentos de onda do Ácrus HTM</h2><div class="grid cards-3" style="margin-top:2rem"><div class="card"><b>755 nm</b><h3>Alexandrite</h3><p>Comprimento de onda Alexandrite para protocolos definidos por profissional habilitado.</p></div><div class="card"><b>808 nm</b><h3>Diodo</h3><p>Faixa de Diodo integrada à plataforma Triple Wave.</p></div><div class="card"><b>1064 nm</b><h3>Nd:YAG</h3><p>Comprimento de onda Nd:YAG para possibilidades de atendimento conforme avaliação.</p></div></div></div></section>
<section class="section"><div class="container prose"><span class="eyebrow">Para a clínica</span><h2>Equipamento para a agenda da sua clínica</h2><p>O Ácrus HTM pode compor uma operação de Laser Day ou uma data específica de atendimento. A Áurea Laser comunica entrega, montagem e preparação técnica conforme as condições combinadas.</p><h2>Conforto e preparação</h2><p>O sistema de resfriamento da ponteira é uma característica do equipamento. O atendimento deve seguir avaliação, treinamento e parâmetros apropriados para cada caso.</p></div></section><section class="section" style="background:#0f1110"><div class="container" style="max-width:850px"><span class="eyebrow">Perguntas frequentes</span><h2>Sobre o Ácrus HTM</h2><FAQ items={faq}/></div></section><CTA label="Alugar Ácrus HTM" message="Olá! Quero consultar a disponibilidade do Ácrus HTM Triple Wave para minha clínica."/>
</BaseLayout>
