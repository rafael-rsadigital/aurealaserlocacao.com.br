---
import BaseLayout from '../layouts/BaseLayout.astro'; import CTA from '../components/CTA.astro'; import FAQ from '../components/FAQ.astro'; import {site,whatsappUrl} from '../data/site';
const faq=[{q:'O que é a tecnologia Triple Wave?',a:'É a combinação dos comprimentos de onda Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm em uma mesma plataforma.'},{q:'O equipamento possui resfriamento?',a:'Sim. O Ácrus HTM comunica sistema de resfriamento da ponteira, que deve ser utilizado conforme os parâmetros e a preparação técnica adequados.'},{q:'Posso usar o equipamento em um Laser Day?',a:'Sim. A locação é especialmente adequada para clínicas que desejam organizar uma operação de Laser Day, sempre mediante consulta de disponibilidade.'}];
const schema={"@context":"https://schema.org","@type":"Product",name:'Ácrus HTM Triple Wave',brand:{"@type":"Brand",name:'HTM'},description:'Equipamento profissional de laser com três comprimentos de onda para locação por clínicas de estética.'};
---
<BaseLayout title="Ácrus HTM Triple Wave: Locação para Clínicas | Áurea Laser" description="Conheça o Ácrus HTM Triple Wave: Alexandrite 755 nm, Diodo 808 nm e Nd:YAG 1064 nm para operações de clínicas de estética." schema={schema} breadcrumbs={[{label:'Ácrus HTM'}]}>
<section class="section"><div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:center"><div><span class="eyebrow">Equipamento profissional</span><h1>Ácrus HTM Triple Wave</h1><p style="font-size:1.25rem">Uma plataforma que combina três comprimentos de onda para ampliar as possibilidades de atendimento da sua clínica, conforme avaliação e parâmetros adequados.</p><a class="btn btn-primary" href={whatsappUrl('Olá! Gostaria de consultar a disponibilidade do Ácrus HTM para a minha clínica.')}>Consultar disponibilidade</a></div><div class="card"><img src={site.equipmentImage} alt="Equipamento Ácrus HTM Triple Wave" width="627" height="482" style="width:100%"/></div></div></section>
<section class="section" style="background:var(--ink);color:#fff"><div class="container"><span class="eyebrow">Tecnologia Triple Wave</span><h2 style="color:#fff">Três comprimentos. Uma operação mais versátil.</h2><div class="grid cards-3" style="margin-top:2rem"><div class="card"><b>755 nm</b><h3>Alexandrite</h3><p>Comprimento de onda Alexandrite para protocolos definidos por profissional habilitado.</p></div><div class="card"><b>808 nm</b><h3>Diodo</h3><p>Faixa de Diodo integrada à plataforma Triple Wave.</p></div><div class="card"><b>1064 nm</b><h3>Nd:YAG</h3><p>Comprimento de onda Nd:YAG para possibilidades de atendimento conforme avaliação.</p></div></div></div></section>
<section class="section"><div class="container prose"><span class="eyebrow">Para a clínica</span><h2>Equipamento preparado para uma agenda planejada.</h2><p>O Ácrus HTM pode compor uma operação de Laser Day ou uma data específica de atendimento. A Áurea Laser comunica entrega, montagem e preparação técnica, além de possibilidade de fornecimento com ou sem aplicadora, conforme o planejamento e as condições contratadas.</p><h2>Conforto e preparação</h2><p>O sistema de resfriamento da ponteira é uma característica do equipamento. O atendimento deve seguir avaliação, treinamento e parâmetros apropriados para cada caso.</p></div></section><section class="section" style="background:#0f1110"><div class="container" style="max-width:850px"><span class="eyebrow">Perguntas frequentes</span><h2>Sobre o Ácrus HTM</h2><FAQ items={faq}/></div></section><CTA label="Alugar Ácrus HTM" message="Olá! Quero consultar a disponibilidade do Ácrus HTM Triple Wave para minha clínica."/>
</BaseLayout>
